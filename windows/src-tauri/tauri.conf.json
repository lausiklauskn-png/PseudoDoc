{
  "$schema":"https://schema.tauri.app/config/2",
  "productName":"PseudoDoc Pro",
  "mainBinaryName":"pseudodoc-pro",
  "version":"0.2.0",
  "identifier":"de.familyprojekt.pseudodoc",
  "build":{"frontendDist":"../dist","beforeBuildCommand":"node tools/build-web.mjs"},
  "app":{"withGlobalTauri":false,"windows":[],"security":{"csp":null}},
  "bundle":{
    "active":true,"targets":["nsis"],"publisher":"Family-Projekt",
    "category":"Productivity","shortDescription":"Dateien Sieb für Sieb sortieren – offline",
    "resources":{"../runtime/":"runtime/"},
    "icon":["icons/icon.ico"],
    "windows":{"webviewInstallMode":{"type":"downloadBootstrapper","silent":true},"nsis":{"installMode":"currentUser","languages":["German","English"],"installerHooks":"../installer/hooks.nsh"}}
  }
}
